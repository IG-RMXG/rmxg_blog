# 统一换行符，避免 Windows / Linux 之间产生整文件差异
* text=auto eol=lf

# Windows 批处理脚本必须保持 CRLF，否则 cmd.exe 可能解析异常
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.icns binary
*.webp binary
*.bmp  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.eot  binary
*.jar  binary
*.zip  binary
*.gz   binary
*.7z   binary
*.apk  binary
*.pdf  binary
*.xls  binary
*.xlsx binary
*.doc  binary
*.docx binary
