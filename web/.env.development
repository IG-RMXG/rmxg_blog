# ── 开发环境（development）────────────
# 加载时机：`yarn dev`（即 vite，mode 默认 development），Vite 启动时读取本文件。
# 只有 VITE_ 前缀的变量会被注入前端 import.meta.env，其余仅在 vite.config.js 里可见。

# 页面标题
# 构建期注入，是 settings.js 中 title 的来源，也用作浏览器标签的兜底标题
VITE_APP_TITLE = 后台管理系统

# 开发环境配置
VITE_APP_ENV = 'development'

# 管理系统/开发环境
# 该前缀同时是 axios 的 baseURL 和 dev server 代理的匹配键：
# /dev-api/xxx → vite.config.js 的 proxy['/dev-api'] → 网关 8889 并剥离前缀。
# 改动这里的值必须同步改代理键，否则请求会落到前端 80 端口并 404。
VITE_APP_BASE_API = '/dev-api'
