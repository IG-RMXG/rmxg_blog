# ── 生产环境（production）────────────
# 加载时机：`yarn build:prod`（vite build，mode 默认 production）。
# 生产构建不会启动 dev server，所以下面的 VITE_APP_BASE_API 不再是 vite 代理键，
# 而是要求部署侧把 /prod-api 反向代理到网关；前缀须与 nginx location 等配置保持一致。

# 页面标题
VITE_APP_TITLE = 后台管理系统

# 生产环境配置
VITE_APP_ENV = 'production'

# 管理系统/生产环境
VITE_APP_BASE_API = '/prod-api'

# 是否在打包时开启压缩，支持 gzip 和 brotli
# 只有 build 时才会传给 vite/plugins/compression.js：写 gzip 才生成 .gz 预压缩文件，
# 写成 gzip,brotli 可同时产出 .br；留空或删掉该行即不压缩。原始文件保留，不会只留压缩包。
VITE_BUILD_COMPRESS = gzip