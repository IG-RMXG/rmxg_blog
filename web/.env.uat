# UAT 验收环境（vite --mode uat 加载本文件）
# 用法：cd web && yarn dev:uat   （端口 81，代理到 UAT 网关 8890）
# 该标题会显示在浏览器标签上，用于一眼区分当前开的是 UAT 还是 DEV 页面
VITE_APP_TITLE = UAT 测试环境

# utils/uat.js 里的 isUat 就是拿这个值做全等比较（构建期被静态替换成布尔常量），
# UAT 专属 UI（如 UatBanner）与请求分支都依赖它，改成别的字符串会让这些分支静默失效
VITE_APP_ENV = 'uat'

# 走独立代理前缀 /uat-api（vite.config.js 里配置目标 8890），
# 与 DEV 的 /dev-api 区分，两套前端可同时运行
VITE_APP_BASE_API = '/uat-api'

# 本文件没有配置 VITE_BUILD_COMPRESS，因此以 --mode uat 打包不会产出 .gz 预压缩文件，
# 这一点与 production / staging 不同（它们是 gzip 的）
